# Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment to ignore Addressables data
# /[Aa]ssets/AddressableAssetsData/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# IDE・OS（各自の環境のもの）
.vs/
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini

# Scene Fusion: 各自の設定（選んだプロジェクト、表示、ログ）。セッションの設定は作った人の値が使われる
/Assets/KinematicSoup/SceneFusion/Editor/SceneFusionConfig.asset
/Assets/KinematicSoup/SceneFusion/Editor/SceneFusionConfig.asset.meta

# Meta XR: local-only (LAN address / access token) and generated binaries
/Assets/Resources/DevAgentSettings.asset
/Assets/Resources/DevAgentSettings.asset.meta
/Assets/XR/APILayers~/

# 外部素材: 再配布できない物は Assets/Local/ に置く（Git に上げない）。CONTRIBUTING 第 7 章
/Assets/Local/
/Assets/Local.meta

# 外部素材: Unity で使わない元データ（.blend）とプレビューの動画・GIF は入れない
/Assets/ArtisticResources/ThirdParty/**/Blend/
/Assets/ArtisticResources/ThirdParty/**/Blend.meta
/Assets/ArtisticResources/ThirdParty/**/Blends/
/Assets/ArtisticResources/ThirdParty/**/Blends.meta
/Assets/ArtisticResources/ThirdParty/**/*.blend
/Assets/ArtisticResources/ThirdParty/**/*.blend.meta
/Assets/ArtisticResources/ThirdParty/**/Preview.mp4
/Assets/ArtisticResources/ThirdParty/**/Preview.mp4.meta
/Assets/ArtisticResources/ThirdParty/**/Preview.gif
/Assets/ArtisticResources/ThirdParty/**/Preview.gif.meta

# 外部素材: OBJ 形式のフォルダは入れる（上の [Oo]bj/ は大文字小文字を区別しない環境で OBJ/ にも当たってしまうため）
!/Assets/ArtisticResources/ThirdParty/**/OBJ/
